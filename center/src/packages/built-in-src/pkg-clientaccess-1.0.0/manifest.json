{
  "name": "pkg-clientaccess",
  "version": "1.0.0",
  "description": "RPC Client Access latency + CAS perfmon counters",
  "author": "ExDashboard",
  "type": "timeseries",
  "database": {
    "metricTable": "rpc_latency",
    "metricColumns": {
      "agent_id": { "type": "varchar(64)" },
      "ts": { "type": "datetime" },
      "metric": { "type": "varchar(128)" },
      "value": { "type": "double" }
    }
  },
  "agent": { "intervalSec": 60, "timeoutMs": 15000 },
  "roleFlags": 4
}
